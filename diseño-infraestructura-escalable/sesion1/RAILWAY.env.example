# =============================================================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE EN RAILWAY (PRESUPUESTO $5 USD/MES)
# =============================================================================
# Todas las comunicaciones entre microservicios se realizan a través de la
# red privada de Railway (*.railway.internal). Solo api-gateway expone dominio público.

# -----------------------------------------------------------------------------
# 1. POSTGRESQL GESTIONADO EN RAILWAY (Instancia compartida)
# -----------------------------------------------------------------------------
# Ambas bases de datos lógicas residen en el mismo contenedor para ahorrar costos:
# - security_db (autenticación y usuarios)
# - rag_db (vectores pgvector para soporte RAG)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CzGTNghuYzLkuscWHwkbeNmsEKvuyrRb
POSTGRES_HOST=postgres.railway.internal
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# 2. MINIO (Emulador S3 Ultra-Ligero, 0.25 vCPU, 128 MB RAM)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecure123
MINIO_ENDPOINT=http://minio.railway.internal:9000
PORT=9000

# -----------------------------------------------------------------------------
# 3. API-GATEWAY (Spring Cloud Gateway - Único con Dominio Público HTTPS)
# -----------------------------------------------------------------------------
PORT=8080
JAVA_TOOL_OPTIONS="-XX:+UseSerialGC -Xss256k -XX:MaxRAMPercentage=60.0 -Xmx220m"
SECURITY_SERVICE_URI=http://back-security-sesion1.railway.internal:8080
SECURITY_SERVICE_INTERNAL_URI=http://back-security-sesion1.railway.internal:8080
SOPORTE_RAG_URI=http://soporte-rag-mt.railway.internal:8080
EUREKA_ENABLED=false

# -----------------------------------------------------------------------------
# 4. BACK-SECURITY-SESION1 (Autenticación JWT, WebFlux, R2DBC)
# -----------------------------------------------------------------------------
PORT=8080
JAVA_TOOL_OPTIONS="-XX:+UseSerialGC -Xss256k -XX:MaxRAMPercentage=60.0 -Xmx256m"
SPRING_PROFILES_ACTIVE=qa
SPRING_R2DBC_URL=r2dbc:postgresql://postgres.railway.internal:5432/security_db
SPRING_R2DBC_USERNAME=postgres
SPRING_R2DBC_PASSWORD=CzGTNghuYzLkuscWHwkbeNmsEKvuyrRb
SPRING_SQL_INIT_MODE=always

# Redis externo (Upstash Serverless Free Tier)
BSG_SECURITY_REDIS_ENABLED=true
BSG_SECURITY_AWS_DYNAMODB_ENABLED=false
SPRING_DATA_REDIS_HOST=tu-redis.upstash.io
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=tu_token_upstash
SPRING_DATA_REDIS_SSL_ENABLED=true

# -----------------------------------------------------------------------------
# 5. SOPORTE-RAG-MT (Core RAG, Spring AI, pgvector, MinIO S3)
# -----------------------------------------------------------------------------
PORT=8080
JAVA_TOOL_OPTIONS="-XX:+UseSerialGC -Xss256k -XX:MaxRAMPercentage=65.0 -Xmx380m"
SPRING_PROFILES_ACTIVE=nube
DATABASE_URL=jdbc:postgresql://postgres.railway.internal:5432/rag_db
DATABASE_USER=postgres
DATABASE_PASSWORD=CzGTNghuYzLkuscWHwkbeNmsEKvuyrRb

# MongoDB Atlas (Cluster M0 Gratuito)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/soporte_rag?retryWrites=true&w=majority

# OpenAI API
OPENAI_API_KEY=sk-tu-api-key-de-openai
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SOPORTE_RAG_VECTOR_EMBEDDING_DIM=768
SOPORTE_RAG_EMBEDDINGS_PROVIDER=spring-ai

# MinIO S3 Emulator
SOPORTE_RAG_S3_ENABLED=true
SOPORTE_RAG_S3_ENDPOINT=http://minio.railway.internal:9000
SOPORTE_RAG_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminsecure123
EUREKA_ENABLED=false
