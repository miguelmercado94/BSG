# ─────────────────────────────────────────────────────────────────────────────
# Frontend → API Gateway (puerto 8080)
# ─────────────────────────────────────────────────────────────────────────────
#
# Arquitectura:
#   Frontend (Vite :5173) → proxy → API Gateway (:8080) → {soporte-rag-mt, back-security}
#
# El API Gateway enruta:
#   /docviz/**        → soporte-rag-mt (backend principal, puerto 8082)
#   /security-auth/** → back-security (micro de seguridad, puerto 8081)
#
# En desarrollo local con Vite, el proxy reescribe:
#   /api → /docviz   en 127.0.0.1:8080
#   /security-api → /security-auth   en 127.0.0.1:8080
#
# El API Gateway requiere Authorization: Bearer <jwt> para rutas protegidas.
# ─────────────────────────────────────────────────────────────────────────────

# Base del backend principal (soporte-rag-mt via gateway).
# Con proxy de Vite (npm run dev):
VITE_API_URL=/api
#
# Sin proxy (navegador → gateway directo, requiere CORS habilitado):
# VITE_API_URL=http://127.0.0.1:8080/docviz

# Base del micro de seguridad (back-security via gateway).
# Con proxy de Vite:
VITE_SECURITY_URL=/security-api
#
# Sin proxy (navegador → gateway directo):
# VITE_SECURITY_URL=http://127.0.0.1:8080/security-auth
